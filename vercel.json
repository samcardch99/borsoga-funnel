{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://borsogastudio.com http://localhost:4321; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.borsogastudio.com"
        }
      ],
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://borsogastudio.com/plans/es/",
      "permanent": true,
      "missing": [
        {
          "type": "host",
          "value": "admin.borsogastudio.com"
        }
      ]
    },
    {
      "source": "/en",
      "destination": "https://borsogastudio.com/plans/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "https://borsogastudio.com/plans/",
      "permanent": true
    },
    {
      "source": "/interior-design",
      "destination": "https://borsogastudio.com/plans/es/interior-design/",
      "permanent": true
